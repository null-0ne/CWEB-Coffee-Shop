
<h1>{{title}}</h1>

{{#if imageFiles.length}}
  <form action="/image-list" method="GET">
    <input type="search" name="search" placeholder="Search images..." value="{{oldInput.search}}" />
    <select name="sort">
      <option value="name" {{#if (eq oldInput.sort "name")}}selected{{/if}}>Sort By Name</option>
      <option value="size" {{#if (eq oldInput.sort "size")}}selected{{/if}}>Sort By Size</option>
      <option value="date" {{#if (eq oldInput.sort "date")}}selected{{/if}}>Sort By Date</option>
    </select>
    <button type="submit">Sort</button>
  </form>  
  {{#each imageFiles}}
    <div class="card">
      <span>
        <h3>{{this.originalName}}</h3>
        <p>Type: {{this.mimeType}}</p>
        <p>Size: {{formatSizeMb this.size}}</p>
        <p>Uploaded by: {{this.uploadedBy}}</p>
        <p>Date: {{formatShortDate this.uploadedAt}}</p>
      </span>
      <span>
        <img src="/images/{{this.fileName}}" alt="{{this.originalName}}" style="width: auto; max-height: 10em;" />
      </span>
    </div>
  {{/each}}
{{else}}
  <p>No files uploaded yet.</p>
{{/if}}
