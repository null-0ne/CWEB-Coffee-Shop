<div class="card">
    <h3>Menu</h3>
     <form action="/menu" method="GET">
        <input type="search" name="search" placeholder="Search menu items" value="{{oldInput.search}}" />
        <select name="sort">
          <option value="type" {{#if (eq oldInput.sort "type")}}selected{{/if}}>Search By Type</option>
           <option value="name" {{#if (eq oldInput.sort "name")}}selected{{/if}}>Search By Name</option>
        </select>
        <button type="submit">Search</button>
  </form>  
  
    <ul>
        {{#each menuItems}}
            <li>{{this.itemName}}</li>
        {{/each}}
    </ul>

</div>

Add a menu Item
<div class="card">
  <h1>Add A Menu Item</h1>
    {{#if error}}
    <p class="error">{{error}}</p>
  {{/if}}

  {{#if success}}
    <p class="success">Item uploaded successfully</p>
  {{/if}}
      
  <form action="/menu" method="POST" >
    <label>Select item name</label>
    <input type="text" name="itemName" required />
     <label>Select item type</label>
    <input type="text" name="itemType" required />
    <button type="submit">Upload</button>
  </form>
</div>