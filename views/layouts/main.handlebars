<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{title}}</title>
  <link rel="stylesheet" href="/app.css" />
</head>
<body>
  <nav>
    <a href="/">Home</a>
    <a href="/showcase">Showcase Gallery</a>
    {{#if user}}
      <span class="rt"> 
        <form action="/logout" method="POST" >
        <button type="submit">Log Out</button>
        </form>
        </span> 
      <span class="rt">
        <form action="/profile" >
        <button type="submit">Profile</button>
        </form>
      </span>
        
      <span class="rt"> Welcome, {{user.userName}} </span> 
    {{else}}
      <span class="rt"> <a href="/login">Login</a> </span> 
    {{/if}}
    {{!-- USER WHO IS LOGGED IN --}}
  </nav>

  <div class="container">
    {{{body}}}
  </div>
</body>
</html>
