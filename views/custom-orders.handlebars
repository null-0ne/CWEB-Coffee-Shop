<h1>{{title}}</h1>

{{#if user}}
  <form>

    <label for="menu-select">Pick Item from Menu</label>

    {{#each menu_list}}
    <div class="card">
      <h3>{{this.name}}</h3>
      {{#each this.items}}
      <p>{{this.title}} - ${{this.price}}</p>

      {{/each}}
    </div>
    {{/each}}

    </form>

{{else}}
  <p>Please <a href="/login">log in</a> to place a custom order.</p>
{{/if}}




