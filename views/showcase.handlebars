<h1>{{title}}</h1>
{{!--Errors from the validator plus the missing or invalid file checks--}}
{{#if errors.length}}
  <div class="error">
    <ul>
      {{#each errors}}
        <li>{{this.msg}}</li>
      {{/each}}
    </ul>
  </div>
{{/if}}

{{!--The idea is that only the logged-users can upload with title and description for their photo--}}
{{#if user}}
<h1>Upload Photo</h1>
{{!--same with the example must use enctype="multipart/formdata" required for uploading photo using multer--}}
<form action="/showcase" method="POST" enctype="multipart/form-data">
  <label>Title</label>
  <input type ="text" name="title" value="{{oldInput.title}}" required />

  <label>Description (optional) </label>
  <textarea name = "description">{{oldInput.description}}</textarea>

  <label>Select image</label>
  <input type="file" name="photo" required />
  <button type="submit">Upload</button>
</form>
{{else}}
<p><a href = "/login">Login</a> to upload a photo</p>
{{/if}}

{{#if hasPhotos}}
<h2>Gallery</h2>

{{!--t0d0: /get with the search + sort form --}}
<form action ="/showcase" method="GET">
  <input type="search" placeholder="Search by title or description" value="{{oldInput.search}}" />
  <select name="sort">
    <option value ="title" {{#if (eq oldInput.sort "title")}}selected {{/if}}>Sort By Title</option>
    <option value ="date" {{#if (eq oldInput.sort "date")}}selected {{/if}}>Sort By Newest</option>
  </select>
  <button type ="submit">Sort</button>

  {{#each photos}}
    <div class="card">
      <span>
        <h3>{{this.title}}</h3>
        {{#if this.description}}
          <p>{{this.description}}</p>
        {{/if}}
        <p>File Name: {{this.fileName}}</p>
        <p>Uploaded By: {{this.userId}}</p>
        <p>Uploaded At: {{this.uploadDate}}</p>
      </span>
      <span>
        <img src ="/images/{{this.fileName}}" alt ="{{this.title}}" style="width: auto; max-height 10em;"/>
      </span>
    </div>
  {{/each}}
{{/if}}